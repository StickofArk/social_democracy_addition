on-arrival: {!
if (Q.pf_strength) {
    Q.pf_strength_2 = Q.pf_strength.toFixed(1);
}
if (Q.vc_strength) {
    Q.vc_strength_2 = Q.vc_strength.toFixed(1);
}
if (Q.rl_strength) {
    Q.rl_strength_2 = Q.rl_strength.toFixed(1);
}
if (Q.csp_strength) {
    Q.csp_strength_2 = Q.csp_strength.toFixed(1);
}
!}

= Paramilitaries

{!<span class="tooltip-text" title="The Popular Front is a popular organization for defending democracy, mostly affiliated with the Progressive Alliance of Socialists and Democrats.">Popular-Front</span>!} Strength: [+ pf_strength_2 +] thousand

