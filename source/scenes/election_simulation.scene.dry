title: Election Simulation
set-jump: post_election


- @2068: 2068 future scenario
- @2070: 2070 future scenario
- @2072: 2072 (July) future scenario

@2068
on-arrival: {!
Q.workers = 46; // industry and trade
Q.old_middle = 13; // "old mittelstand"
// 16.4 trade & commerce, 6.6 public and private services, 4.4 domestic help
Q.new_middle = 14; // "new mittelstand"
Q.rural = 25; // agriculture and forestry employment... but many of those are proletarians so...
// source: https://surface.syr.edu/cgi/viewcontent.cgi?filename=3&article=1016&context=books&type=additional page 43, table 3.3
Q.unemployed = 8.6;
Q.christians = 30;

Q.classes = ['workers', 'old_middle', 'new_middle', 'rural', 'unemployed', 'christians'];
Q.parties = ['spd', 'left', 'epp', 'green', 'renew', 'esn', 'acc', 'other'];

// Support for party by social group
// they don't have to sum to 100 since the electoral calculations will be normalized.
Q.workers_spd = 60;
Q.workers_left = 20;
Q.workers_epp = 5;
Q.workers_green = 0;
Q.workers_renew = 0;
Q.workers_esn = 5;
Q.workers_acc = 0;
Q.workers_other = 10;

Q.old_middle_spd = 5;
Q.old_middle_left = 0;
Q.old_middle_epp = 5;
Q.old_middle_green= 10;
Q.old_middle_renew = 25;
Q.old_middle_esn = 25;
Q.old_middle_acc = 10;
Q.old_middle_other = 10;

Q.new_middle_spd = 5;
Q.new_middle_left = 0;
Q.new_middle_epp = 10;
Q.new_middle_green= 25;
Q.new_middle_renew = 25;
Q.new_middle_esn = 10;
Q.new_middle_acc = 5;
Q.new_middle_other = 15;

Q.rural_spd = 10;
Q.rural_left = 0;
Q.rural_epp = 5;
Q.rural_green= 5;
Q.rural_renew = 15;
Q.rural_esn = 45;
Q.rural_acc = 5;
Q.rural_other = 10;

Q.unemployed_spd = 25;
Q.unemployed_left = 55;
Q.unemployed_epp = 1;
Q.unemployed_green = 0;
Q.unemployed_renew = 0;
Q.unemployed_esn = 5;
Q.unemployed_acc = 15;
Q.unemployed_other = 9;

Q.christians_spd = 15;
Q.christians_left = 5;
Q.christians_epp = 50;
Q.christians_green = 0;
Q.christians_renew = 5;
Q.christians_esn = 5;
Q.christians_acc = 0;
Q.christians_other = 10;
!}
go-to: election_algorithm
set-jump: post_election

